<Application x:Class="NETGal.Player.Windows.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="CanvasBrush" Color="#0D141D" />
    <SolidColorBrush x:Key="PanelBrush" Color="#151F2C" />
    <SolidColorBrush x:Key="LineBrush" Color="#3A4859" />
    <SolidColorBrush x:Key="AccentBrush" Color="#E19B67" />
    <SolidColorBrush x:Key="TextBrush" Color="#F0F2F5" />
    <SolidColorBrush x:Key="MutedBrush" Color="#A2ADBD" />
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
      <Setter Property="Background" Value="{StaticResource PanelBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="14,9" />
      <Setter Property="Margin" Value="0,4,0,0" />
      <Setter Property="FontSize" Value="13" />
    </Style>
  </Application.Resources>
</Application>
