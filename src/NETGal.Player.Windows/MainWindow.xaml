<Window x:Class="NETGal.Player.Windows.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="NETGal 游戏播放器" Width="1120" Height="720" MinWidth="760" MinHeight="520" WindowStartupLocation="CenterScreen" Background="{StaticResource CanvasBrush}" UseLayoutRounding="True">
  <Grid>
    <Image x:Name="BackgroundImage" Stretch="UniformToFill" Opacity="0.82" />
    <Border Background="#CC0D141D" />
    <Grid Margin="28">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <DockPanel Grid.Row="0">
        <TextBlock Text="NETGAL 游戏播放器" Foreground="{StaticResource MutedBrush}" FontSize="11" FontWeight="SemiBold" />
        <TextBlock x:Name="SceneLabel" DockPanel.Dock="Right" Foreground="{StaticResource MutedBrush}" FontSize="11" />
      </DockPanel>
      <Grid Grid.Row="1">
        <TextBlock x:Name="LoadingLabel" Text="正在加载游戏..." Foreground="{StaticResource AccentBrush}" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Grid>
      <Border Grid.Row="2" Background="#E60D141D" BorderBrush="#664A596B" BorderThickness="1" Padding="22,18" MaxWidth="920" HorizontalAlignment="Left">
        <StackPanel>
          <TextBlock x:Name="SpeakerLabel" Foreground="{StaticResource AccentBrush}" FontSize="16" FontWeight="Bold" />
          <TextBlock x:Name="DialogueLabel" Foreground="{StaticResource TextBrush}" FontSize="22" TextWrapping="Wrap" LineHeight="34" Margin="0,8,0,8" />
          <StackPanel x:Name="ChoicesPanel" />
          <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
            <Button x:Name="RestartButton" Content="重新开始" Click="RestartButton_Click" />
            <Button Content="保存进度" Click="SaveButton_Click" Margin="8,0,0,0" />
            <Button Content="读取进度" Click="LoadButton_Click" Margin="8,0,0,0" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
